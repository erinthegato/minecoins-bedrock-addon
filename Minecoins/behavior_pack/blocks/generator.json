{
  "format_version": "1.21.60",
  "minecraft:block": {
    "description": {
      "identifier": "minecoins:generator",
      "menu_category": {
        "category": "construction",
        "group": "minecoins:itemGroup.name.server_components"
      },
      "states": {
        "minecoins:lit": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:material_instances": {
        "*": {
          "texture": "mcn_generator",
          "render_method": "opaque",
          "face_dimming": true,
          "ambient_occlusion": true
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.4
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6
      },
      "minecraft:map_color": "#4a3b28",
      "minecraft:light_emission": 0,
      "minecraft:geometry": "minecraft:geometry.full_block"
    },
    "permutations": [
      {
        "condition": "q.block_state('minecoins:lit') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "mcn_generator",
              "render_method": "opaque",
              "face_dimming": true,
              "ambient_occlusion": true
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecoins:lit') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "mcn_generator_lit",
              "render_method": "opaque",
              "face_dimming": true,
              "ambient_occlusion": true
            }
          }
        }
      }
    ]
  }
}
